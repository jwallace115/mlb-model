+    sc["to_by_def"] = (sc["next_timeout"] == 1) & (sc["next_to_team"] == sc["defteam"])
+    sc["off_state"] = np.where(sc["score_differential"] < 0, "trail",
+                      np.where(sc["score_differential"] == 0, "tied", "lead"))
